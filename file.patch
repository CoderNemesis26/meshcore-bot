 modules/service_plugins/packet_capture_service.py |  2 +-
 tests/unit/test_packet_capture_observer_name.py   |  6 ++----
 tests/unit/test_packet_capture_payload_decode.py  |  5 ++++-
 4 files changed, 17 insertions(+), 6 deletions(-)

